#!/bin/bash
set -e
COMMON="$(dirname "$0")/../lib/domain-php-common.sh"
[[ -f "$COMMON" ]] || COMMON="/usr/local/vesta/bin/myvesta-domain-php-common.sh"
# shellcheck disable=SC1090
source "$COMMON"

domain="${1:-}"
parameter="${2:-}"
value="${3:-}"
restart="${4:-yes}"
[[ -n "$domain" && -n "$parameter" && -n "$value" ]] || die "usage: v-change-domain-php-config DOMAIN PARAMETER VALUE [yes|no]"
[[ "$restart" = yes || "$restart" = no ]] || die "restart must be yes or no"
UPDATE_COMMAND="$(dirname "$0")/v-update-domain-php-config"
[[ -x "$UPDATE_COMMAND" ]] || UPDATE_COMMAND="/usr/local/vesta/bin/v-update-domain-php-config"
exec "$UPDATE_COMMAND" "$domain" "$restart" set "$parameter" "$value"
