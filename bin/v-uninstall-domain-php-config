#!/bin/bash
set -e

STATE_ROOT="${MYVESTA_DOMAIN_PHP_STATE:-/var/lib/myvesta-domain-php-config}"
UNINSTALLER="$STATE_ROOT/install/tools/uninstall.sh"
[[ -x "$UNINSTALLER" ]] || { echo 'ERROR: installed uninstaller is missing' >&2; exit 1; }
exec env MYVESTA_DOMAIN_PHP_UNINSTALL_INTERNAL=yes "$UNINSTALLER" "$@"
